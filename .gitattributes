# Normalise line endings on the way into git. Without this, a Windows checkout
# with core.autocrlf=true hands CRLF to the hooks while the Linux CI runner sees
# LF, and `mixed-line-ending` fights with itself forever.
* text=auto eol=lf

# Binary-ish files git should not touch.
*.png binary
*.jpg binary
*.gz binary
*.tgz binary

# Generated - collapse in PR diffs.
stacks/helm/charts/*/README.md linguist-generated=true
